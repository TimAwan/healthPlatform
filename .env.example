# 复制为 .env 并按环境修改，.env 已被 .gitignore 排除，禁止提交真实密钥（说明书第 35/36 章）

# MySQL
MYSQL_ROOT_PASSWORD=root123456
DB_HOST=localhost
DB_PORT=3306

# Redis
REDIS_PASSWORD=redis123456
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_USER=health
RABBITMQ_PASSWORD=rabbit123456

# Nacos（本地开发默认值，生产必须替换）
NACOS_AUTH_TOKEN=SecretKey012345678901234567890123456789012345678901234567890123456789
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=security

# JWT（生产必须替换为高强度随机值）
JWT_SECRET=dev-only-jwt-secret-change-me-please-0123456789

# 后端服务连库（默认与 MYSQL_ROOT_PASSWORD 一致，改库密码时需同步修改）
DB_USERNAME=root
DB_PASSWORD=root123456

# 初始管理员（system-service 首次启动且无用户时创建）
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=Admin@123456

# 微服务内部调用令牌（auth/system 等服务间接口校验，生产必须替换）
INTERNAL_TOKEN=dev-internal-token

# 阿里云 OSS（生产）
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_BUCKET=
OSS_ENDPOINT=

# 短信服务（二期接入）
SMS_ACCESS_KEY=
SMS_SECRET_KEY=
